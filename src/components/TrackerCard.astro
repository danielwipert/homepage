---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
import { liveValues } from '../lib/live';
const p = project.data;
const v = liveValues(project);
---
<a href={`/work/${project.id}/`} class="tracker lift">
  <div class="bezel">
    <div class="screen-violet crt soft">
      <div class="v-label">{v.statLabel}</div>
      <div class="v-num glowp">{v.stat}</div>
    </div>
  </div>
  <div style="flex: 1 1 200px; min-width: 0;">
    <div class="when"><span class="lamp">UPDATED WEEKLY</span></div>
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
  </div>
</a>
