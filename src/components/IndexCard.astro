---
// Library index card used for featured writing ("Start here").
// Looks like a card-catalog card: label row, ruled lines under the text, a footer, and a punched hole.
import type { Post } from '../lib/posts';
import { topicName } from '../data/topics';
import { readingMinutes } from '../lib/posts';
interface Props { post: Post; n: number; }
const { post, n } = Astro.props;
const tilts = ['-1deg', '0.6deg', '-0.4deg', '0.8deg', '-0.7deg', '0.3deg'];
const topic = post.data.topics[0];
const when = post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).toUpperCase();
---
<a href={`/writing/${post.id}/`} class="icard lift" style={`transform: rotate(${tilts[(n - 1) % tilts.length]});`}>
  <div class="ilabel">
    <span class="inum">NO. {String(n).padStart(2, '0')}</span>
    {topic && <span class="itopic">{topicName(topic).toUpperCase()}</span>}
  </div>
  <div class="ilines">
    <h3>{post.data.title}</h3>
    <p>{post.data.excerpt}</p>
  </div>
  <div class="ifoot">
    <span>{readingMinutes(post.body)} MIN READ</span>
    <span class="ihole" aria-hidden="true"></span>
    <span>{when}</span>
  </div>
</a>

<style>
  .icard {
    position: relative; display: flex; flex-direction: column; height: 100%;
    text-decoration: none; color: #14161B; background: #FFFFFF;
    border: 2px solid #14161B; border-radius: 4px; padding: 20px 24px 16px;
    box-shadow: 6px 6px 0 #14161B, 0 22px 34px rgba(0,0,0,.25);
  }
  .icard:hover { color: #14161B; }

  /* One-line label: number on the left, topic on the right (shortened with "..." if it's long). */
  .ilabel {
    display: flex; justify-content: space-between; gap: 12px; align-items: baseline;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; white-space: nowrap;
    padding-bottom: 10px; margin-bottom: 4px; border-bottom: 2px solid #C2410C;
  }
  .inum { color: #C2410C; font-weight: 700; }
  .itopic { overflow: hidden; text-overflow: ellipsis; }

  /* Ruled lines: every text line is exactly 32px tall, and the rule sits at the bottom of each line. */
  .ilines {
    flex: 1;
    background: repeating-linear-gradient(to bottom, transparent 0 31px, #C9D9EA 31px 32px);
  }
  h3 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 23px; line-height: 32px; padding-top: 2px; margin-bottom: -2px; }
  p { margin: 0; font-size: 17px; line-height: 32px; font-style: italic; color: #2B2F38; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* Footer: reading time, the punched hole, and the date. */
  .ifoot {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 14px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 1.5px; color: #5A606B;
  }
  /* A real hole: the mint background shows through, with a dark rim like punched card stock. */
  .ihole {
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--mint); border: 2px solid #14161B;
    box-shadow: inset 0 3px 3px rgba(0,0,0,.35);
  }
</style>
