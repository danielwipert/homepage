---
// Animated stipple portrait. Dots "ink in" from the face outward, glowing amber
// for a moment before they settle. Click to replay. Static image without JavaScript
// or with reduced motion. Dots come from scripts/hedcut.py -> public/portrait/.
---
<figure class="hedcut">
  <div class="frame">
    <img src="/portrait/hedcut.png" alt="Stipple portrait of Daniel Wipert" width="900" height="900" class="still" />
    <canvas class="ink" aria-hidden="true"></canvas>
  </div>
  <figcaption class="mono">DRAWN IN 12,000 DOTS · <button type="button" class="replay">REDRAW</button></figcaption>
</figure>

<script>
  type Data = { size: number; dots: [number, number, number][] };
  const fig = document.querySelector<HTMLElement>('.hedcut');
  const canvas = fig?.querySelector<HTMLCanvasElement>('canvas.ink');
  const still = fig?.querySelector<HTMLImageElement>('img.still');
  const replay = fig?.querySelector<HTMLButtonElement>('.replay');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fig && canvas && still && replay && !reduce) {
    fetch('/portrait/hedcut.json').then((r) => r.json()).then((data: Data) => {
      const ctx = canvas.getContext('2d')!;
      let raf = 0;
      const ink = () => getComputedStyle(fig).color;

      const fit = () => {
        const px = canvas.clientWidth * Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = canvas.height = Math.round(px);
        return px / data.size;
      };

      const draw = () => {
        cancelAnimationFrame(raf);
        const k = fit();
        const n = data.dots.length;
        const dur = 2200;
        const glow = Math.round(n * 0.05);
        const color = ink();
        const t0 = performance.now();
        fig.classList.add('drawing');
        const frame = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const shown = Math.round(n * (1 - Math.pow(1 - p, 2.2)));
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = color;
          ctx.beginPath();
          for (let i = 0; i < Math.max(0, shown - glow); i++) {
            const [x, y, r] = data.dots[i];
            ctx.moveTo(x * k + r * k, y * k);
            ctx.arc(x * k, y * k, r * k, 0, Math.PI * 2);
          }
          ctx.fill();
          if (p < 1) {
            ctx.fillStyle = '#FFB000';
            ctx.beginPath();
            for (let i = Math.max(0, shown - glow); i < shown; i++) {
              const [x, y, r] = data.dots[i];
              ctx.moveTo(x * k + r * k * 1.3, y * k);
              ctx.arc(x * k, y * k, r * k * 1.3, 0, Math.PI * 2);
            }
            ctx.fill();
            raf = requestAnimationFrame(frame);
          } else {
            fig.classList.remove('drawing');
          }
        };
        raf = requestAnimationFrame(frame);
      };

      fig.classList.add('live');
      const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { draw(); io.disconnect(); } }, { threshold: 0.4 });
      io.observe(fig);
      replay.addEventListener('click', draw);
      canvas.parentElement!.addEventListener('click', draw);
      let w = canvas.clientWidth;
      window.addEventListener('resize', () => { if (canvas.clientWidth !== w && !fig.classList.contains('drawing')) { w = canvas.clientWidth; draw(); } });
    }).catch(() => {});
  }
</script>

<style>
  .hedcut { margin: 0; flex: 0 0 auto; color: var(--ink); }
  .frame { position: relative; width: min(300px, 78vw); aspect-ratio: 1; border: 2px solid var(--ink); border-radius: 22px; background: var(--surface); box-shadow: 8px 8px 0 var(--ink), 0 22px 36px var(--shadow); overflow: hidden; cursor: pointer; }
  .still, .ink { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ink { opacity: 0; }
  .live .ink { opacity: 1; }
  .live .still { opacity: 0; }
  @media (prefers-color-scheme: dark) { .still { filter: invert(.93); } }
  figcaption { margin-top: 14px; font-size: 11px; letter-spacing: 2px; color: var(--muted); }
  .replay { font: inherit; letter-spacing: inherit; color: var(--orange-text); background: none; border: none; padding: 0; text-decoration: underline; cursor: pointer; }
  :global(.no-js) .replay { display: none; }
</style>
