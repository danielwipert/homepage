---
// Engraved portrait (made by scripts/engrave.py). It "prints" top to bottom behind
// a glowing amber scan line when it scrolls into view. Click to reprint.
// Without JavaScript, or with reduced motion, it simply shows the finished portrait.
---
<figure class="hedcut">
  <button type="button" class="frame" aria-label="Reprint the portrait">
    <img src="/portrait/engraving.webp" alt="Engraved portrait of Daniel Wipert, smiling, in glasses" width="1000" height="1000" class="art" />
    <span class="scan" aria-hidden="true"></span>
  </button>
  <figcaption class="mono">ENGRAVED PORTRAIT · CLICK TO REPRINT</figcaption>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('.hedcut');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fig && !reduce) {
    const run = () => {
      fig.classList.remove('printing');
      void fig.offsetWidth; // restart the animation
      fig.classList.add('printing');
    };
    fig.classList.add('ready');
    const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { run(); io.disconnect(); } }, { threshold: 0.4 });
    io.observe(fig);
    fig.querySelector('.frame')?.addEventListener('click', run);
  }
</script>

<style>
  .hedcut { margin: 0; flex: 0 0 auto; }
  .frame { position: relative; display: block; width: min(300px, 78vw); aspect-ratio: 1; padding: 0; border: 2px solid var(--ink); border-radius: 22px; background: #FFFFFF; box-shadow: 8px 8px 0 var(--ink), 0 22px 36px var(--shadow); overflow: hidden; cursor: pointer; }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .scan { position: absolute; left: 0; right: 0; top: 0; height: 3px; background: #FFB000; box-shadow: 0 0 14px 4px rgba(255,176,0,.65); opacity: 0; pointer-events: none; }

  /* Before it scrolls into view: blank paper. */
  .ready .art { clip-path: inset(0 0 100% 0); }
  .printing .art { animation: print 2.4s cubic-bezier(.45,.05,.35,1) forwards; }
  .printing .scan { animation: scan 2.4s cubic-bezier(.45,.05,.35,1) forwards; }
  @keyframes print { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes scan { 0% { top: 0; opacity: 1; } 92% { opacity: 1; } 100% { top: 100%; opacity: 0; } }

  figcaption { margin-top: 14px; font-size: 11px; letter-spacing: 2px; color: var(--muted); }
  .frame:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
</style>
