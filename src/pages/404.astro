---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page doesn't exist." noindex>
  <section class="wrap" style="padding-top: 96px; padding-bottom: 120px;">
    <div class="crt" style="max-width: 720px; border-radius: 20px; padding: 28px 30px; background: radial-gradient(ellipse at 50% 40%, #1C222B, #07090C); border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--ink);">
      <pre class="glow" style="position: relative; z-index: 1; margin: 0; font-family: var(--font-crt); font-size: clamp(18px, 3.6vw, 28px); line-height: 1.35; color: var(--phosphor); white-space: pre-wrap;">C:\DANIEL&gt; OPEN THIS-PAGE
ERROR 404: FILE NOT FOUND
C:\DANIEL&gt; <span class="cursor"></span></pre>
    </div>
    <h1 style="margin: 40px 0 0; font-weight: 800; font-size: clamp(36px, 5vw, 64px); letter-spacing: -1.5px;">That page isn't here.</h1>
    <div style="margin-top: 28px; display: flex; flex-wrap: wrap; gap: 14px;">
      <a href="/" class="btn btn-orange">GO HOME →</a>
      <a href="/work/" class="btn btn-plain">SEE THE WORK</a>
      <a href="/writing/" class="btn btn-plain">WRITING</a>
    </div>
  </section>
</Base>
