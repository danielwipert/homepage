---
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import IndexCard from '../../components/IndexCard.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, featured } from '../../lib/posts';
import { TOPICS } from '../../data/topics';
import { SITE } from '../../site';

const posts = await getPosts();
const picks = featured(posts);
const usedTopics = Object.entries(TOPICS).filter(([slug]) => posts.some((p) => p.data.topics.includes(slug)));
const byYear = posts.reduce<Record<string, typeof posts>>((acc, p) => {
  const y = String(p.data.date.getUTCFullYear());
  (acc[y] ||= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear).sort((a, b) => +b - +a);
const hasLibrary = posts.length > 0;
---
<Base title="Writing" description="Daniel Wipert's essays and notes on AI, operations, and the economics of both, newest first and sorted by topic." current="writing">
  {hasLibrary && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" slot="head" />}

  <section class="wrap" style="padding-top: 72px;">
    <p class="mono" style="margin: 0; font-size: 13px; letter-spacing: 3px; color: var(--muted);">C:\DANIEL&gt; DIR /WRITING</p>
    <h1 style="margin: 12px 0 0; font-weight: 800; font-size: clamp(48px, 7vw, 96px); line-height: .95; letter-spacing: -2.5px;">Writing</h1>
    <p style="margin: 20px 0 0; max-width: 54ch; font-size: 22px; line-height: 1.45;">Essays and notes on AI, operations, and the economics of both.{hasLibrary ? ` ${posts.length} pieces, newest first.` : ' Every piece is moving here from LinkedIn, into a library you can browse by date and topic.'}</p>
  </section>

  {!hasLibrary && (
    <section class="wrap" style="padding-bottom: 120px;">
      <div class="crt" style="margin-top: 48px; max-width: 720px; border-radius: 20px; padding: 28px 30px; background: radial-gradient(ellipse at 50% 40%, #1C222B, #07090C); border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--ink);">
        <pre class="glow" style="position: relative; z-index: 1; margin: 0; font-family: var(--font-crt); font-size: clamp(16px, 3.4vw, 24px); line-height: 1.35; color: var(--phosphor); white-space: pre-wrap;" set:html={'C:\\DANIEL&gt; IMPORT /LINKEDIN\nCOPYING ARCHIVE ........ IN PROGRESS\nLIBRARY OPENS .......... SOON\nC:\\DANIEL&gt; <span class="cursor"></span>'}></pre>
      </div>
      <div style="margin-top: 40px; display: flex; flex-wrap: wrap; gap: 14px;">
        <a href={SITE.linkedin} class="btn btn-orange">READ IT ON LINKEDIN FOR NOW →</a>
        <a href="/work/" class="btn btn-plain">SEE THE WORK</a>
      </div>
    </section>
  )}

  {hasLibrary && picks.length > 0 && (
    <section class="shelf">
      <div class="wrap" style="padding-top: 72px; padding-bottom: 80px;">
        <div class="section-head" style="margin-bottom: 40px;">
          <Plate dept="★" title="Start here" />
          <p class="intro">The foundational pieces. <span>If you read nothing else, read these.</span></p>
        </div>
        <div class="cards">{picks.map((p, i) => <IndexCard post={p} n={i + 1} />)}</div>
      </div>
    </section>
  )}

  {hasLibrary && (
    <section class="wrap" style="padding-top: 72px; padding-bottom: 110px;">
      <div class="section-head" style="margin-bottom: 28px;">
        <Plate dept="ALL" title="The library" />
        <p class="intro"><span>Search everything, or browse by topic.</span></p>
      </div>

      <div id="search" class="search"></div>

      {usedTopics.length > 0 && (
        <nav class="topics" aria-label="Topics">
          {usedTopics.map(([slug, t]) => <a href={`/writing/topics/${slug}/`} class="mono">{t.name.toUpperCase()}</a>)}
        </nav>
      )}

      {years.map((y) => (
        <section class="year">
          <h2 class="ylabel"><span class="glow">{y}</span></h2>
          <ul class="rows">{byYear[y].map((p) => <PostRow post={p} />)}</ul>
        </section>
      ))}
    </section>
  )}
</Base>

{hasLibrary && (
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
)}
{hasLibrary && (
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (window.PagefindUI) new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false });
    });
  </script>
)}

<style>
  .shelf { margin-top: 56px; background: var(--mint); color: var(--mint-ink); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); box-shadow: inset 0 10px 24px var(--shadow); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 32px; }
  .search { margin-bottom: 28px; max-width: 760px;
    --pagefind-ui-primary: var(--orange-text); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--ink); --pagefind-ui-tag: var(--bg); --pagefind-ui-border-width: 2px; --pagefind-ui-border-radius: 14px;
    --pagefind-ui-font: var(--font-body); }
  .topics { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }
  .topics a { font-size: 12px; letter-spacing: 2px; padding: 9px 14px; border: 2px solid var(--ink); border-radius: 999px; color: var(--ink); text-decoration: none; background: var(--surface); box-shadow: 0 3px 0 var(--ink); }
  .topics a:hover { background: var(--ink); color: var(--bg); }
  .year { margin-top: 24px; }
  .ylabel { margin: 0; display: inline-block; font-family: var(--font-crt); font-weight: 400; font-size: 34px; letter-spacing: 1px; color: var(--phosphor); background: #0B0E12; padding: 4px 16px; border-radius: 10px; border: 2px solid var(--ink); }
  .rows { list-style: none; margin: 12px 0 0; padding: 0; border-top: 2px solid var(--ink); }
</style>
