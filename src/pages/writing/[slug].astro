---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, fmtDate, readingMinutes } from '../../lib/posts';
import { topicName } from '../../data/topics';
import { SITE } from '../../site';
// Article fonts (self-hosted): Plex Serif for reading, a display serif for the headline.
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-serif/600.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const related = all
  .filter((p) => p.id !== post.id && p.data.topics.some((t) => d.topics.includes(t)))
  .slice(0, 2);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  url: new URL(`/writing/${post.id}/`, SITE.url).href,
  ...(d.sourceUrl ? { isBasedOn: d.sourceUrl } : {}),
};
---
<Base title={d.title} description={d.excerpt} jsonLd={ld} current="writing" ogImage={`/og/writing/${post.id}.png`} progress>
  <article class="wrap feature" data-pagefind-body>
    <a href="/writing/" class="crumb mono" data-pagefind-ignore>← THE LIBRARY</a>

    <header class="masthead">
      {d.topics[0] && <a class="kicker mono" href={`/writing/topics/${d.topics[0]}/`} data-pagefind-ignore>{topicName(d.topics[0]).toUpperCase()}</a>}
      <h1>{d.title}</h1>
      <p class="byline mono" data-pagefind-ignore>BY DANIEL WIPERT</p>
    </header>

    <div class="spread">
      <aside class="rail mono" data-pagefind-ignore>
        <div class="rail-in">
          <p><span class="rl">PUBLISHED</span>{fmtDate(d.date).toUpperCase()}</p>
          <p><span class="rl">READING TIME</span>{readingMinutes(post.body)} MIN</p>
          {d.topics.length > 0 && (
            <p><span class="rl">FILED UNDER</span>{d.topics.map((t) => <a href={`/writing/topics/${t}/`}>{topicName(t).toUpperCase()}</a>)}</p>
          )}
          {d.sourceUrl && <p><span class="rl">FIRST ON</span><a href={d.sourceUrl}>LINKEDIN →</a></p>}
        </div>
      </aside>
      <div class="prose story"><Content /></div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap" style="padding-bottom: 96px; max-width: 980px;">
      <h2 class="mono" style="font-size: 13px; letter-spacing: 3px; color: var(--muted); font-weight: 500;">KEEP READING</h2>
      <ul style="list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink);">
        {related.map((p) => <PostRow post={p} />)}
      </ul>
    </section>
  )}
</Base>

<style>
  /* ---------- Magazine feature layout (decision #52) ---------- */
  .feature { --head: 'Fraunces Variable', 'Fraunces', Georgia, serif; --read: 'IBM Plex Serif', Georgia, serif; padding-top: 48px; padding-bottom: 72px; }
  .crumb { display: inline-block; font-size: 12px; letter-spacing: 2px; color: var(--muted); text-decoration: none; margin-bottom: 24px; }
  .crumb:hover { color: var(--orange-text); }

  /* Masthead: kicker, headline, byline, centered like a magazine opener */
  .masthead { text-align: center; max-width: 980px; margin: 0 auto 48px; padding-bottom: 36px; border-bottom: 1px solid var(--ink); position: relative; }
  .masthead::after { content: ''; position: absolute; left: 0; right: 0; bottom: -5px; border-bottom: 1px solid var(--ink); }
  .kicker { display: inline-block; font-size: 12px; letter-spacing: 3px; color: var(--orange-text); text-decoration: none; font-weight: 600; }
  .kicker:hover { text-decoration: underline; }
  h1 { margin: 18px auto 22px; max-width: 18ch; font-family: var(--head); font-weight: 600; font-variation-settings: 'opsz' 144; font-size: clamp(40px, 6.4vw, 84px); line-height: 1.0; letter-spacing: -0.02em; }
  .byline { margin: 0; font-size: 12px; letter-spacing: 3px; color: var(--muted); }

  /* Spread: a narrow margin column next to the text column */
  .spread { display: grid; grid-template-columns: 190px minmax(0, 66ch); gap: 56px; justify-content: center; }
  .rail-in { position: sticky; top: 96px; border-top: 3px solid var(--ink); padding-top: 14px; }
  .rail p { margin: 0 0 18px; font-size: 11.5px; letter-spacing: 1.5px; line-height: 1.6; }
  .rail .rl { display: block; color: var(--muted); font-size: 10px; letter-spacing: 2px; margin-bottom: 2px; }
  .rail a { display: block; color: var(--ink); }
  .rail a:hover { color: var(--orange-text); }

  /* Reading text: IBM Plex Serif */
  .story { max-width: none; font-family: var(--read); font-size: 19px; line-height: 1.7; color: var(--ink); }
  .story :global(p), .story :global(ul), .story :global(ol) { margin: 0 0 22px; }

  /* Opening: big first letter, first line in small capitals */
  .story > :global(p:first-of-type::first-letter) { float: left; font-family: var(--head); font-weight: 600; font-variation-settings: 'opsz' 144; font-size: 5.6em; line-height: .8; padding: 6px 10px 0 0; color: var(--orange-text); }
  .story > :global(p:first-of-type::first-line) { font-variant: small-caps; letter-spacing: .06em; font-weight: 600; }

  /* Section breaks: an ornament above each heading */
  .story :global(h2), .story :global(h3) { font-family: var(--head); font-weight: 600; font-variation-settings: 'opsz' 48; letter-spacing: -0.01em; }
  .story :global(h2) { font-size: 30px; line-height: 1.2; margin: 64px 0 16px; }
  .story :global(h2::before), .story :global(h3:not(h2 + h3)::before) { content: '❦'; display: block; text-align: center; font-size: 22px; color: var(--orange-text); margin-bottom: 40px; font-family: var(--read); }
  .story :global(h3) { font-size: 27px; line-height: 1.2; margin: 64px 0 14px; }
  .story :global(h2 + h3) { font-size: 23px; margin-top: 24px; }
  .story :global(hr) { border: 0; text-align: center; margin: 48px 0; }
  .story :global(hr::before) { content: '❦'; color: var(--orange-text); font-size: 22px; }
  .story :global(li::marker) { color: var(--orange-text); }
  .story :global(blockquote) { margin: 36px 0; padding: 4px 0 4px 24px; border: 0; border-left: 3px solid var(--orange-text); border-radius: 0; background: none; box-shadow: none; font-style: italic; font-size: 21px; }

  /* End mark after the last word */
  .story > :global(:last-child::after) { content: ' ■'; color: var(--orange-text); font-size: .7em; vertical-align: 1px; }

  @media (max-width: 900px) {
    .spread { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .rail-in { position: static; display: flex; flex-wrap: wrap; gap: 4px 28px; border-top: 0; border-bottom: 1px solid var(--shadow); padding: 0 0 12px; margin-bottom: 28px; }
    .rail p { margin: 0; }
    .rail a { display: inline; margin-right: 10px; }
    .story { font-size: 18px; }
  }
</style>
